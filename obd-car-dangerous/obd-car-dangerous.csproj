<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 target brings in the WinRT projections needed for Bluetooth LE (GATT). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>obd_car_dangerous</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>

  <!-- Raster pieces of the Full System Scan screen (tools/scan_assets.py) and the Roboto faces it is set in. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Scan\*.png" LogicalName="Scan.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Fonts\*.ttf" LogicalName="Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>